{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "noEmit": true, "strict": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
